# Copy to .env and fill in the SAP values (same service the payment portal uses)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
UPLOAD_DIR=uploads

# SAP 'All open items' API (basic auth)
SAP_OPEN_ITEMS_URL=https://<host>/http/QAS/Get/All_Open_items
SAP_API_USERNAME=<sap-basic-auth-username>
SAP_API_PASSWORD=<sap-basic-auth-password>
SAP_DEFAULT_COMPANY_CODE=EPL

# Auth (JWT)
SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Portal users: comma-separated 'username:password:Full Name' triples
PORTAL_USERS=admin:admin123:System Admin
